# Supabase Configuration
# Copy this file to .env and fill in your values

# Get these from your Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Paystack Configuration
# Get this from Paystack Dashboard → Settings → API Keys & Webhooks
# Test keys start with pk_test_, live keys start with pk_live_
VITE_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY

# ============================================
# INTEGRATION SECRETS (Supabase Edge Functions)
# ============================================
# These are stored in Supabase: Project Settings → Edge Functions → Secrets.
# The CLI can also set them via: supabase secrets set KEY=value

# Google Sheets / Google Drive (Google Cloud Console)
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the authorized redirect URI registered in Google Console
GOOGLE_CALLBACK_URL=https://<ref>.supabase.co/functions/v1/integrations/auth-callback

# Zoho (Zoho Developer Console)
# https://api-console.zoho.com → create a Self Client / Server-based app
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=https://<ref>.supabase.co/functions/v1/integrations/auth-callback

# Shopify (Shopify Partners)
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_DEFAULT_SHOP=your-store.myshopify.com
SHOPIFY_CALLBACK_URL=https://<ref>.supabase.co/functions/v1/integrations/auth-callback

# QuickBooks (Intuit Developer)
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_CALLBACK_URL=https://<ref>.supabase.co/functions/v1/integrations/auth-callback

# Xero (Xero Developer Center)
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=https://<ref>.supabase.co/functions/v1/integrations/auth-callback

# Used to sign the OAuth state parameter (anti-CSRF). Any long random string.
OAUTH_STATE_SECRET=replace-with-a-long-random-string
